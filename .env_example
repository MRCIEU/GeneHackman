DATA_DIR=
RESULTS_DIR=
RDFS_DIR=
PIPELINE_DATA_DIR=/Users/wt23152/Documents/Projects/scratch/020/data/
QTL_DATA_DIR=
# Container tag / SIF basename: genehackman_<DOCKER_VERSION>.sif (e.g. 1.0.0 or develop).
DOCKER_VERSION=
# Optional: build SIF from local Docker (no Hub pull). Example: docker-daemon://mrcieu/genehackman:develop
# GENEHACKMAN_SINGULARITY_DOCKER_REFERENCE=docker-daemon://mrcieu/genehackman:develop
# On Apple Silicon, run_pipeline.sh passes --arch amd64 to singularity build (image is amd64-only).
# Override arch or disable: GENEHACKMAN_SINGULARITY_BUILD_ARCH=amd64 | GENEHACKMAN_SINGULARITY_NO_ARCH=1
GENEHACKMAN_PROFILE=snakemake/local/
PIPELINE_LOG_DIR=
# Optional: Lima VM name if apptainer only exists inside Lima (default: apptainer)
# GENEHACKMAN_LIMA_INSTANCE=apptainer

# Optional: Snakemake --singularity-prefix for pulled images (see PLATFORM_SETUP.md on macOS/Lima).
# GENEHACKMAN_SINGULARITY_PREFIX=/tmp/genehackman_snakemake_singularity
